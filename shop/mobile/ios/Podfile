target 'Shop' do
  use_frameworks!
  platform :ios, '16'
  
  # https://github.com/elai950/AlertToast
  pod 'AlertToast', '1.3.7'
  # https://github.com/airbnb/lottie-ios
  pod 'lottie-ios', '4.0.1'
  # https://github.com/SwiftGen/SwiftGen
  pod 'SwiftGen', '6.6.2'
  # https://github.com/realm/SwiftLint
  pod 'SwiftLint'
  # https://github.com/nicklockwood/SwiftFormat
  pod 'SwiftFormat/CLI'
  # https://github.com/onevcat/Kingfisher
  pod 'Kingfisher', '7.12.0'
  # https://github.com/SVGKit/SVGKit
  pod 'SVGKit'
  # https://github.com/yonat/MultiSlider
  pod 'MultiSlider'
  # https://github.com/realm/realm-swift
  # Fixed version to avoid "assumeIsolated(_:file:line:)' is only available in application extensions for iOS 17.0 or newer"
  # on xcode less than 15.3
  pod 'RealmSwift', '10.53.1'
  
  pod 'shared', :path => '../../../shared'
end

post_install do |installer|
 installer.pods_project.targets.each do |target|
  target.build_configurations.each do |config|
   config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
  end
 end
end